// I create five invoice-age bands for the receivables chart; this table stays disconnected.
Invoice Age =
DATATABLE (
    "Age Band", STRING,
    "MinDays", INTEGER,
    "MaxDays", INTEGER,
    "Sort", INTEGER,
    {
        { "0-30 days", 0, 30, 1 },
        { "31-90 days", 31, 90, 2 },
        { "91-180 days", 91, 180, 3 },
        { "181-365 days", 181, 365, 4 },
        { "366+ days", 366, 999999, 5 }
    }
)
